# Root environment configuration
# Copy to .env and adjust values for local development.
# NEVER commit real credentials.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bilingual_edu

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Backend URL used by the frontend rewrite to reach the FastAPI backend
# (Docker network hostname; use http://localhost:8000 for local development)
BACKEND_URL=http://backend:8000

# Backend DATABASE_URL used by SQLAlchemy/Alembic
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bilingual_edu

# Authentication
# MUST be at least 32 characters (SEC-001); the backend refuses to start otherwise.
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-long-random-string-32-chars
AUTH_TOKEN_EXPIRY_MINUTES=10080
