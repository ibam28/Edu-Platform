# Environment template for staging/prototype deployments (M24)
# NEVER commit real secrets. Copy to .env and fill values SECURELY.
# NEVER copy your local development .env to a server.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=bilingual_edu

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Backend DATABASE_URL used by SQLAlchemy/Alembic
# (Docker network — use postgres hostname)
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-password@postgres:5432/bilingual_edu

# Authentication
# MINIMUM 32 characters — generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-long-random-string-32-chars
AUTH_TOKEN_EXPIRY_MINUTES=10080

# Frontend→Backend URL (Docker internal network)
BACKEND_URL=http://backend:8000