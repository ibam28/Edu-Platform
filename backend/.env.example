# Backend environment configuration
# Copy to .env and adjust values for local development.

APP_NAME=bilingual-edu-platform
APP_VERSION=0.0.1
ENVIRONMENT=development

# PostgreSQL connection (used by SQLAlchemy/Alembic)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bilingual_edu

# Authentication
# Secret used to sign session tokens. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER commit a real value; change it outside the prototype.
# MUST be at least 32 characters (SEC-001); the backend refuses to start
# with an empty or short secret.
AUTH_SECRET_KEY=replace-with-a-long-random-string-32-chars
AUTH_TOKEN_EXPIRY_MINUTES=10080
